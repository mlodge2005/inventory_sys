# Cyberdeck Inventory environment.
# The installer creates /etc/cyberdeck-inventory.env and does not overwrite it.
# Do not put passwords or tokens in this file. Version 1 has no application secrets.

INVENTORY_ENVIRONMENT=production
INVENTORY_DATABASE_PATH=/var/lib/cyberdeck-inventory/inventory.db
INVENTORY_BACKUP_DIR=/var/lib/cyberdeck-inventory/backups
# 0.0.0.0 serves every IPv4 interface so one process can answer LAN and Tailscale.
# The installer prints a warning if a public address is present. Do not port-forward this port.
INVENTORY_HOST=0.0.0.0
INVENTORY_PORT=8765
INVENTORY_FRONTEND_DIST=/opt/cyberdeck-inventory/current/frontend/dist
INVENTORY_LOG_LEVEL=info
# Comma-separated browser origins. Leave empty for same-origin only.
INVENTORY_ALLOWED_ORIGINS=
# Optional URL encoded by `inventory qr` when several addresses exist.
INVENTORY_PUBLIC_URL=
# Git remote and branch used by scripts/update.sh
INVENTORY_GIT_REMOTE=origin
INVENTORY_GIT_BRANCH=main
